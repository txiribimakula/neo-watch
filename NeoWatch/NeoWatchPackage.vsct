<?xml version="1.0" encoding="utf-8" ?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<Extern href="stdidcmd.h" />
	<Extern href="vsshlids.h" />
	<Extern href="VSDbgCmd.h"/>
	<Extern href="VsDebugGuids.h"/>

	<Commands package="guidPackage">
        <Groups>
            <Group guid="guidPackageCmdSet" id="BlueprintToolsGroup" priority="0x0800">
                <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
            </Group>
            <Group guid="guidPackageCmdSet" id="RightClickMenu" priority="0x0300">
                <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
            </Group>
        </Groups>
        <Bitmaps>
			<Bitmap guid="neoIcon" href="Resources\morpheus.bmp" usedList="neoIcon1"/>
		</Bitmaps>
		<Buttons>
            <Button guid="guidPackageCmdSet" id="idEditBlueprints" priority="0x0090" type="Button">
                <Parent guid="guidPackageCmdSet" id="BlueprintToolsGroup" />
                <Strings>
                    <ButtonText>Edit Neo Watch Blueprints</ButtonText>
                    <CommandName>NeoWatch.EditBlueprints</CommandName>
                </Strings>
            </Button>
            <Button guid="guidPackageCmdSet" id="idCopyBlueprintPrompt" priority="0x0100" type="Button">
                <Parent guid="guidPackageCmdSet" id="BlueprintToolsGroup" />
                <Strings>
                    <ButtonText>Copy Neo Watch Blueprint Prompt</ButtonText>
                    <CommandName>NeoWatch.CopyBlueprintPrompt</CommandName>
                </Strings>
            </Button>
			<Button guid="guidPackageCmdSet" id="idCommand" priority="0x099" type="Button">
				<Parent guid="guidVSDebugGroup" id="IDG_DEBUG_WINDOWS_INSPECT"/>
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Icon guid="neoIcon" id="neoIcon1" />
				<Strings>
					<ButtonText>Neo Watch</ButtonText>
				</Strings>
			</Button>
            <!-- IDG_WATCH_EDIT es el grupo que el menu contextual del Watch monta arriba del todo.
                 0x0180 cae entre Copy Value (0x0150) y Add Watch (0x0200). -->
            <Button guid="guidPackageCmdSet" id="idCommandAddFromWatch" priority="0x0180" type="Button">
                <Parent guid="guidVSDebugGroup" id="IDG_WATCH_EDIT"/>
                <CommandFlag>DynamicVisibility</CommandFlag>
                <Icon guid="neoIcon" id="neoIcon1" />
                <Strings>
                    <ButtonText>Add Neo Watch</ButtonText>
                </Strings>
            </Button>
            <Button guid="guidPackageCmdSet" id="idCommandAdd" priority="0x0100" type="Button">
                <Parent guid="guidPackageCmdSet" id="RightClickMenu"/>
                <CommandFlag>DynamicVisibility</CommandFlag>
                <Icon guid="neoIcon" id="neoIcon1" />
                <Strings>
                    <ButtonText>Add Neo Watch</ButtonText>
                </Strings>
            </Button>
		</Buttons>
	</Commands>

    <!-- Segunda colocacion del mismo comando: la vista flotante de la variable sobre el editor.
         0x0180 cae entre Edit Value (0x0100) y Add Watch (0x0200), igual que en el Watch. -->
    <CommandPlacements>
        <CommandPlacement guid="guidPackageCmdSet" id="idCommandAddFromWatch" priority="0x0180">
            <Parent guid="guidVSDebugGroup" id="IDG_DATATIP_WATCH"/>
        </CommandPlacement>
    </CommandPlacements>

    <KeyBindings>
        <KeyBinding guid="guidPackageCmdSet" id="idCommandAdd" editor="guidVSStd97"
                    key1="W" mod1="Control Alt" key2="N" mod2="Control Alt" />
    </KeyBindings>
    
	<VisibilityConstraints>
        <VisibilityItem guid="guidPackageCmdSet" id="idCommand" context="UICONTEXT_Debugging" />
        <VisibilityItem guid="guidPackageCmdSet" id="idCommandAdd" context="UICONTEXT_Debugging" />
        <VisibilityItem guid="guidPackageCmdSet" id="idCommandAddFromWatch" context="UICONTEXT_Debugging" />
	</VisibilityConstraints>

	<Symbols>
		<GuidSymbol name="guidPackage" value="{2f2f2923-9433-4dcb-b3b6-373c61e85461}" />

		<GuidSymbol name="guidPackageCmdSet" value="{AB6200EA-5C89-4F3C-AEEB-1374F1F578FB}">
            <IDSymbol value="256" name="idCommand" />
            <IDSymbol value="255" name="idCommandAdd" />
            <IDSymbol value="254" name="idCommandAddFromWatch" />
            <IDSymbol value="253" name="idCopyBlueprintPrompt" />
            <IDSymbol value="252" name="idEditBlueprints" />
            <IDSymbol value="0x1041" name="BlueprintToolsGroup" />
            <IDSymbol name="RightClickMenu" value="0x1040" />
        </GuidSymbol>
		<GuidSymbol name="neoIcon" value="{153861FB-E433-49C8-BE51-5289844FC485}">
			<IDSymbol name="neoIcon1" value="1" />
		</GuidSymbol>
	</Symbols>
	
</CommandTable>
