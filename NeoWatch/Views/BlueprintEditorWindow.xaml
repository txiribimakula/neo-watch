<platform:DialogWindow x:Class="NeoWatch.BlueprintEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
    xmlns:theme="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
    Title="Neo Watch - Blueprints" Width="760" Height="600" MinWidth="420" MinHeight="320"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    theme:ImageThemingUtilities.ImageBackgroundColor="{DynamicResource {x:Static shell:VsColors.WindowKey}}"
    Background="{DynamicResource {x:Static shell:VsBrushes.WindowKey}}"
    Foreground="{DynamicResource {x:Static shell:VsBrushes.WindowTextKey}}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Static shell:VsResourceKeys.ButtonStyleKey}}"/>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static shell:VsResourceKeys.TextBoxStyleKey}}">
            <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="AddBlueprint" ToolTip="Add blueprint"
                        AutomationProperties.Name="Add blueprint">
                    <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Add}"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="CopyPrompt" ToolTip="Copy AI prompt"
                        AutomationProperties.Name="Copy AI prompt">
                    <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Copy}"/>
                </Button>
            </StackPanel>
            <TextBlock Text="Blueprints" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="BlueprintList" ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" Padding="0,5"
                                BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch"
                                          Foreground="{DynamicResource {x:Static shell:VsBrushes.WindowTextKey}}">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="4,3"
                                                   FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                                    </Expander.Header>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                                             FontSize="13" MinHeight="140" MaxHeight="320" Margin="24,8,0,6"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Blueprint content" Loaded="EditorLoaded"/>
                                </Expander>
                                <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource ToolButton}"
                                        Click="RemoveBlueprint" ToolTip="Remove blueprint"
                                        AutomationProperties.Name="Remove blueprint">
                                    <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Delete}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="ErrorText" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource {x:Static shell:VsBrushes.WindowTextKey}}"
                   AutomationProperties.LiveSetting="Assertive"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" MinWidth="80" Padding="12,5" Margin="0,0,8,0" Click="SaveBlueprints"/>
            <Button Content="Cancel" MinWidth="80" Padding="12,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</platform:DialogWindow>
