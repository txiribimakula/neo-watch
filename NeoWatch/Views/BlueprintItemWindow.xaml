<platform:DialogWindow x:Class="NeoWatch.BlueprintItemWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    Title="Neo Watch - Blueprint" Width="720" Height="560" MinWidth="420" MinHeight="320"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{DynamicResource {x:Static shell:VsBrushes.WindowKey}}"
    Foreground="{DynamicResource {x:Static shell:VsBrushes.WindowTextKey}}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Static shell:VsResourceKeys.ButtonStyleKey}}">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static shell:VsResourceKeys.TextBoxStyleKey}}">
            <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Container type" FontWeight="SemiBold"/>
        <TextBox x:Name="TypeBox" Grid.Row="1" Margin="0,4,0,0"
                 AutomationProperties.Name="Container type"/>

        <TextBlock Grid.Row="2" Margin="0,14,0,4" FontWeight="SemiBold"
                   Text="Definition"/>
        <TextBox x:Name="DefinitionBox" Grid.Row="3" AcceptsReturn="True" AcceptsTab="False"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas"
                 AutomationProperties.Name="Definition"/>

        <TextBlock x:Name="ErrorText" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static shell:VsBrushes.WindowTextKey}}"
                   AutomationProperties.LiveSetting="Assertive"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" IsDefault="True" Click="Save"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</platform:DialogWindow>
